<Window x:Class="SAM3CutoutPlugin.SAM3ClickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAM3 - 被写体をクリックして選択" Height="600" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                切り抜きたい対象を【左クリック（青）】してください。除外したい部分は【右クリック（赤）】してください。
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button x:Name="PreviewButton" Content="プレビュー更新" Width="100" Click="PreviewButton_Click"/>
                <TextBlock x:Name="PreviewStatusText" Text="" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
            </StackPanel>
        </StackPanel>

        <!-- 画像表示エリア（Viewboxでスケーリングを管理） -->
        <Viewbox Grid.Row="1" Margin="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="ImageContainer" Background="Black" MouseLeftButtonDown="Image_MouseLeftButtonDown" MouseRightButtonDown="Image_MouseRightButtonDown">
                <Image x:Name="PreviewImage" Stretch="None" />
                <Image x:Name="MaskOverlayImage" Stretch="None" IsHitTestVisible="False" />
                <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False" />
            </Grid>
        </Viewbox>

        <!-- コントロールボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="クリア" Width="100" Margin="0,0,10,0" Click="ClearButton_Click"/>
            <Button Content="このポイントで切り抜き開始" Width="180" Click="RunButton_Click" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
